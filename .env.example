APP_ENV=development
HTTP_ADDR=:8080
PUBLIC_API_URL=http://localhost:8080
FRONTEND_URL=http://localhost:5173
DATABASE_URL=postgres://postgres:postgres@localhost:5432/simpul?sslmode=disable
# Redis is OPTIONAL for the API. Leave REDIS_ADDR empty to run without it: the API serves
# reads and writes normally, reports `redis: disabled` on /health/ready, disables realtime,
# and leaves payroll runs queued. There is no built-in default, precisely so that omitting
# this means "not used" rather than "assume localhost".
#
# The WORKER is different — it consumes a queue that lives in Redis, so it exits non-zero
# at startup when REDIS_ADDR is empty or unreachable, rather than running while doing
# nothing. That is deliberate: a worker that appears healthy but processes nothing is worse
# than one that refuses to start.
REDIS_ADDR=localhost:6379
REDIS_PASSWORD=
REDIS_DB=0
ALLOWED_ORIGINS=http://localhost:5173
ACCESS_TOKEN_SECRET=replace-with-at-least-32-random-characters
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=720h
COOKIE_SECURE=false
# SameSite policy for the refresh cookie: lax (default), strict, or none.
# Leave on `lax` when the SPA and the API share a registrable domain — app.example.com
# and api.example.com count as the same site, so the cookie is still sent.
# Set to `none` when they do not (e.g. a SPA on *.vercel.app calling an API on
# *.onrender.com). Otherwise the browser withholds the cookie from the cross-site
# refresh call and every session dies 15 minutes after login. `none` requires
# COOKIE_SECURE=true; the server refuses to start with that combination inverted.
COOKIE_SAME_SITE=lax
# Kosong diperbolehkan hanya untuk APP_ENV=development/test.
# Produksi wajib base64 dari tepat 32 byte, contoh: openssl rand -base64 32
FIELD_ENCRYPTION_KEY=
# Password applied to every seeded demo user.
#
# This value is PUBLISHED in the repository, so the seed refuses to run with it unless
# APP_ENV is development or test. Set a real password before seeding a production
# deployment — the seeded administrator holds every permission in the workspace, and a
# minimum of 12 characters is enforced.
SEED_ADMIN_PASSWORD=ChangeMe-OnlyForLocalDevelopment-123!
# Comma-separated roles that must complete TOTP MFA before receiving a session.
# Leave empty for a frictionless demo; set to `hr_admin` to require MFA for
# administrators (the login screen then issues an enrollment QR code).
MFA_REQUIRED_ROLES=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
ENTRA_CLIENT_ID=
ENTRA_CLIENT_SECRET=
ENTRA_TENANT_ID=common
